# Site values for atlas.nft: copy to /etc/atlas/nftables-site.nft and edit (provision-pi.sh does this once).
# Every address below is a documentation placeholder (RFC 5737). Replace them with your LAN's real values on the Pi.
# Never commit the edited file.

define LAN_CIDR = 192.0.2.0/24          # the home LAN: may reach SSH (:22), the HUD (:443) and ping
define LAN_BROADCAST = 192.0.2.255      # subnet broadcast (Wake-on-LAN)
define LAN_DNS = 192.0.2.1              # LAN resolver (router or Pi-side resolver); PLAN 5.7
define PI_LAN_IP = 192.0.2.48           # this Pi's reserved LAN address: atlas-ui binds it and its certificate names it
#   (not used by the rules; provision-pi.sh and gen-ui-keys.sh read it). Until it is set, atlas-ui stays off.
define NTP_SERVERS = { 216.239.35.0, 216.239.35.4, 216.239.35.8, 216.239.35.12 }   # time.google.com's fixed addresses
#   (PLAN 5.7). Plain IPv4 only: timesyncd uses this list too. A LAN time server instead: { 192.0.2.1 }. Don't mix
#   Google's servers with others: Google smears leap seconds, most others step.
define DESKTOP_LAN_IP = 192.0.2.20      # the LLM desktop's LAN address (WireGuard endpoint, UDP 51820)
define DESKTOP_WG_IP = 10.77.0.2        # the desktop inside the tunnel (contracts/services.md section 2)
define LAN_PREFIX6 = 2001:db8:1234:5600::/64   # the LAN's global IPv6 prefix (RFC 3849 placeholder): never an internet destination
#   provision-pi.sh refuses to load the firewall while a 2001:db8:: placeholder remains; no IPv6 on the LAN: use fd00::/8
define LAN_ROUTER6 = fe80::1            # the router's link-local address: the only accepted source of IPv6 router advertisements
define NTP_USER = "systemd-timesync"    # the user of your time-sync daemon ("_chrony" for chrony); it must exist when the rules load
define WG_FWMARK = 0x5182               # set `FirewallMark=0x5182` in wg0.netdev ([WireGuard]) so the tunnel's packets are identifiable
