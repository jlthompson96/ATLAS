#!/usr/sbin/nft -f
# ATLAS Pi firewall (PLAN 5.2, contracts/services.md sections 2 and 3). Default deny in every direction.
#
# Load:      nft -f /etc/atlas/atlas.nft          (Debian's nftables.service loads /etc/nftables.conf, which includes it)
# Check:     nft -c -f /etc/atlas/atlas.nft       (needs the atlas-* users to exist: names are resolved to uids at load)
# Site values (addresses of YOUR LAN) live in /etc/atlas/nftables-site.nft, written once by provision-pi.sh from
# deploy/nftables/site.nft.example. The repository only ever contains placeholder addresses.
#
# What this enforces (the proxy's own checks are the second layer; units add IPAddressDeny=any as a third):
#  - output policy DROP: only the flows below leave the Pi;
#  - only `meta skuid atlas-egress` reaches the internet, TCP 443, and never a non-public address;
#  - loopback proxy ports 3131-3136 accept a connection only from the one user each port belongs to (TCP has no
#    SO_PEERCRED, so the port identifies the caller, and this is what makes that true);
#  - DNS only for atlas-egress (and root), only to the LAN resolver, so a compromised service cannot use DNS
#    as an exfiltration channel;
#  - SSH in from the admin device only; the UI on :443 from the LAN only.

include "/etc/atlas/nftables-site.nft"

add table inet atlas
delete table inet atlas

table inet atlas {

    # Addresses that are never internet destinations (kept in step with backend/atlas/egress/addresses.py).
    set nonpublic4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
            192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15,
            198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4
        }
    }

    set nonpublic6 {
        type ipv6_addr
        flags interval
        elements = {
            2001::/23, 2001:db8::/32, 2002::/16, 3fff::/20
        }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop

        # SSH: the admin device only (key-only, passphrase-protected key; deploys use this path).
        ip saddr $ADMIN_IP tcp dport 22 accept

        # HUD: HTTPS and WSS from the home LAN (tighten to listed device IPs in site.nft if wanted).
        ip saddr $LAN_CIDR tcp dport 443 accept

        # WireGuard handshake and data from the desktop.
        ip saddr $DESKTOP_LAN_IP udp dport 51820 accept

        # Ping from the LAN, rate limited.
        ip saddr $LAN_CIDR icmp type echo-request limit rate 5/second accept

        # DHCP replies, IPv6 neighbour discovery.
        udp sport 67 udp dport 68 accept
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept
        # Router advertisements only from the configured router: a rogue RA could redirect the Pi's IPv6 traffic.
        icmpv6 type nd-router-advert ip6 saddr $LAN_ROUTER6 accept

        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy drop;

        # --- loopback: the proxy ports belong to one caller each (services.md section 2) -------------------------
        # Port squatting: whatever binds a proxy port but is not atlas-egress cannot answer anyone (its replies carry
        # the proxy port as source port and are dropped), so a squatter cannot impersonate the proxy to a caller.
        oifname "lo" tcp sport 3131-3136 meta skuid != "atlas-egress" counter drop
        oifname "lo" tcp dport 3131 meta skuid "atlas-google" accept
        oifname "lo" tcp dport 3132 meta skuid "atlas-discord" accept
        oifname "lo" tcp dport 3133 meta skuid "atlas-executor" accept
        oifname "lo" tcp dport 3134 meta skuid "atlas-panels" accept
        oifname "lo" tcp dport 3135 meta skuid "atlas-market" accept
        oifname "lo" tcp dport 3136 meta skuid "atlas-search" accept
        oifname "lo" tcp dport 3131-3136 counter drop
        # SearXNG (127.0.0.1:8888) is reachable by atlas-egress only; the research API queries it for atlas-research.
        oifname "lo" tcp dport 8888 meta skuid "atlas-egress" accept
        oifname "lo" tcp dport 8888 counter drop
        # A local caching resolver (127.0.0.53, dnsmasq) forwards to the internet: loopback port 53 is not free either.
        oifname "lo" meta l4proto { tcp, udp } th dport 53 meta skuid "atlas-egress" accept
        oifname "lo" meta l4proto { tcp, udp } th dport 53 meta skuid "root" accept
        oifname "lo" meta l4proto { tcp, udp } th dport 53 counter drop
        oifname "lo" accept

        ct state established,related accept
        ct state invalid drop

        # --- the Pi's own housekeeping --------------------------------------------------------------------------
        udp sport 68 udp dport 67 accept
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } accept
        # NTP only to the fixed time-server addresses in the site file (PLAN 5.7), and only for the time-sync daemon's
        # user. By IP, so the daemon needs no DNS; provision-pi.sh points timesyncd at the same list.
        meta skuid $NTP_USER ip daddr $NTP_SERVERS udp dport 123 accept
        # DNS: the LAN resolver, for atlas-egress (it resolves allowlisted names itself and pins the answers) and root.
        # No other ATLAS user may resolve names, so DNS cannot carry exfiltrated data.
        meta skuid "atlas-egress" ip daddr $LAN_DNS udp dport 53 accept
        meta skuid "atlas-egress" ip daddr $LAN_DNS tcp dport 53 accept
        meta skuid "root" ip daddr $LAN_DNS udp dport 53 accept
        meta skuid "root" ip daddr $LAN_DNS tcp dport 53 accept

        # --- WireGuard to the desktop (kernel-originated UDP, no skuid) ---------------------------------------
        # Pinned by fwmark: the tunnel's own packets carry $WG_FWMARK (FirewallMark= in wg0.netdev, see the runbook),
        # so no user process can send to the desktop's WireGuard port.
        meta mark $WG_FWMARK ip daddr $DESKTOP_LAN_IP udp dport 51820 accept
        # Over the tunnel: atlas-core only, and only LM Studio (1234) and atlas-hostd (8770).
        oifname "wg0" ip daddr $DESKTOP_WG_IP tcp dport { 1234, 8770 } meta skuid "atlas-core" accept
        oifname "wg0" ip daddr $DESKTOP_WG_IP icmp type echo-request meta skuid "atlas-core" accept

        # --- Wake-on-LAN magic packet (UDP broadcast), sent by the power controller in atlas-core ---------------
        meta skuid "atlas-core" ip daddr { $LAN_BROADCAST, 255.255.255.255 } udp dport { 7, 9 } accept

        # --- THE internet path: atlas-egress, TCP 443, public unicast addresses only ----------------------------
        meta skuid "atlas-egress" tcp dport 443 ip daddr != @nonpublic4 ip daddr != $LAN_CIDR accept
        meta skuid "atlas-egress" tcp dport 443 ip6 daddr 2000::/3 ip6 daddr != @nonpublic6 ip6 daddr != $LAN_PREFIX6 accept
        # PHASE 5, research only (contracts/services.md section 3): TCP 80. Uncomment in the change that ships the
        # research API; the same Unix user serves the CONNECT proxy, which refuses anything but 443 in code.
        # meta skuid "atlas-egress" tcp dport 80 ip daddr != @nonpublic4 ip daddr != $LAN_CIDR accept

        # Everything else, including every other ATLAS service user, is logged (rate limited) and dropped.
        limit rate 5/minute log prefix "atlas-drop " level info
        counter drop
    }
}
