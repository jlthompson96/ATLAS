# ATLAS tunnel for WireGuard for Windows on the LLM desktop (runbook docs/runbooks/wireguard.md, PLAN 5.3).
# In the WireGuard app: "Add Tunnel" > "Add empty tunnel...", name it `atlas`. The app fills in [Interface] PrivateKey
# itself and shows the matching public key: that key goes to the Pi (/etc/atlas/wireguard-desktop.pub). The private key
# never leaves the desktop. Copy the rest of this file below the PrivateKey line and replace the two placeholders.
# Addresses come from contracts/services.md section 2 (Pi 10.77.0.1, desktop 10.77.0.2); the endpoint is RFC 5737.

[Interface]
# PrivateKey = (already there: generated by the app)
Address = 10.77.0.2/32
ListenPort = 51820
# No DNS line: the tunnel carries only Pi <-> desktop traffic and must not change the desktop's DNS.

[Peer]
# The Pi's public key, as printed by deploy/provisioning/gen-wg-key.sh on the Pi.
PublicKey = REPLACE_WITH_THE_PI_PUBLIC_KEY
# Only the Pi's tunnel address: nothing else is routed through the tunnel.
AllowedIPs = 10.77.0.1/32
# The Pi's LAN address (reserve it in the router so it never changes).
Endpoint = 192.0.2.48:51820
