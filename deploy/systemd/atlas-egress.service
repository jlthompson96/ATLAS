# atlas-egress.service: The only process allowed to reach the internet: CONNECT proxy.
# Source of truth: contracts/services.md (user, credentials, sockets, ports, sandbox baseline). Status: Phase 0-1.
#
# Relaxations of the services.md section 5 baseline (each is also marked RELAXED where it applies):
#   IPAddressAllow=any: this is the only service that may reach the internet. nftables still limits it to
#     TCP 443 to non-private addresses; the proxy enforces the per-caller hostname allowlist.
#   RestrictAddressFamilies: AF_INET AF_INET6 added to serve the loopback listeners and connect upstream.

[Unit]
Description=ATLAS egress: The only process allowed to reach the internet: CONNECT proxy
Requires=nftables.service
After=nftables.service
# Known issue P2: start only once the clock is right (audit timestamps, TLS). provision-pi.sh caps the wait
# (systemd-time-wait-sync, 90 s), so a Pi without internet still starts.
Wants=time-sync.target
After=time-sync.target
# Audit is mandatory: no audit socket, no service (fail closed).
Requires=atlas-audit.socket
After=atlas-audit.socket
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=atlas-egress
Group=atlas-egress
# Membership of the shared socket groups (see the .socket units and contracts/proposals).
SupplementaryGroups=atlas-audit-clients

# --- services.md section 5 baseline ---
DynamicUser=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
IPAddressDeny=any
# RELAXED IPAddressAllow: see the header comment.
IPAddressAllow=any
# RELAXED RestrictAddressFamilies: see the header comment.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=atlas/egress
StateDirectoryMode=0700

# --- additional hardening (does not relax the baseline) ---
CapabilityBoundingSet=
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RemoveIPC=yes
UMask=0077

# --- environment ---
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/var/lib/atlas/current/backend

# --- code runs from the active release through the symlink, never a versioned path (services.md section 6) ---
ExecStart=/var/lib/atlas/current/venv/atlas-egress/bin/python -m atlas.egress
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
