# atlas-fallback.socket: /run/atlas/fallback.sock
# Client: atlas-core only. Group atlas-core must contain no other member than the atlas-core user.
# Mode 0660 and a group that only the permitted clients belong to (contracts/services.md section 2).

[Unit]
Description=ATLAS fallback socket

[Socket]
ListenStream=/run/atlas/fallback.sock
SocketUser=atlas-fallback
SocketGroup=atlas-core
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
