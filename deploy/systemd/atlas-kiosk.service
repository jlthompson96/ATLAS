# atlas-kiosk.service: Chromium kiosk session (loopback only).
# Source of truth: contracts/services.md (user, credentials, sockets, ports, sandbox baseline). Status: Phase 2.
# TEMPLATE: the executable below is a placeholder until this service exists; provision-pi.sh installs but does not enable it.
#
# Relaxations of the services.md section 5 baseline (each is also marked RELAXED where it applies):
#   RestrictAddressFamilies: AF_INET for the HUD on https://127.0.0.1 (loopback only via IPAddressAllow).
#   PrivateDevices=no: Chromium needs the GPU (/dev/dri) and input devices.
#   TODO(VM): measure whether MemoryDenyWriteExecute=yes works here (JIT or W+X mappings); relax only if measured necessary.

[Unit]
Description=ATLAS kiosk: Chromium kiosk session (loopback only)
Requires=nftables.service
After=nftables.service
# Known issue P2: start only once the clock is right (audit timestamps, TLS). provision-pi.sh caps the wait
# (systemd-time-wait-sync, 90 s), so a Pi without internet still starts.
Wants=time-sync.target
After=time-sync.target

[Service]
Type=simple
User=atlas-kiosk
Group=atlas-kiosk

# --- services.md section 5 baseline ---
DynamicUser=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# RELAXED PrivateDevices: see the header comment.
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
IPAddressDeny=any
# RELAXED IPAddressAllow: see the header comment.
IPAddressAllow=localhost
# RELAXED RestrictAddressFamilies: see the header comment.
RestrictAddressFamilies=AF_UNIX AF_INET
StateDirectory=atlas/kiosk
StateDirectoryMode=0700

# --- additional hardening (does not relax the baseline) ---
CapabilityBoundingSet=
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RemoveIPC=yes
UMask=0077

# --- environment ---
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/var/lib/atlas/current/backend

# --- code runs from the active release through the symlink, never a versioned path (services.md section 6) ---
# PLACEHOLDER: labwc session wrapper installed by deploy/kiosk in Phase 2; Chromium opens https://127.0.0.1.
ExecStart=/var/lib/atlas/current/kiosk/bin/atlas-kiosk-session
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
