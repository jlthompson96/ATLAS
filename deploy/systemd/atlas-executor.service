# atlas-executor.service: Runs approved write actions only; the only holder of send/post credentials.
# Source of truth: contracts/services.md (user, credentials, sockets, ports, sandbox baseline). Status: Phase 6.
# TEMPLATE: the module below does not exist yet (Phase 6); provision-pi.sh installs but does not enable it.
#
# Relaxations of the services.md section 5 baseline (each is also marked RELAXED where it applies):
#   RestrictAddressFamilies: AF_INET added to reach the atlas-egress proxy on 127.0.0.1:3133
#     (the baseline's AF_UNIX-only cannot work for an HTTPS_PROXY client). IPAddressAllow=localhost keeps it
#     loopback-only; nftables lets only this user connect to its own proxy port.

[Unit]
Description=ATLAS executor: Runs approved write actions only; the only holder of send/post credentials
Requires=nftables.service
After=nftables.service
# Known issue P2: start only once the clock is right (audit timestamps, TLS). provision-pi.sh caps the wait
# (systemd-time-wait-sync, 90 s), so a Pi without internet still starts.
Wants=time-sync.target
After=time-sync.target
# Audit is mandatory: no audit socket, no service (fail closed).
Requires=atlas-audit.socket
After=atlas-audit.socket
# Socket-activated: systemd owns the listening socket and passes it as fd 3 (LISTEN_FDS).
Requires=atlas-executor.socket
After=atlas-executor.socket
# Survives an atlas-egress restart (the proxy just refuses until it is back).
Wants=atlas-egress.service
After=atlas-egress.service

[Service]
Type=simple
User=atlas-executor
Group=atlas-executor
# Membership of the shared socket groups (see the .socket units and contracts/proposals).
SupplementaryGroups=atlas-audit-clients

# --- services.md section 5 baseline ---
DynamicUser=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
IPAddressDeny=any
# RELAXED IPAddressAllow: see the header comment.
IPAddressAllow=localhost
# RELAXED RestrictAddressFamilies: see the header comment.
RestrictAddressFamilies=AF_UNIX AF_INET
StateDirectory=atlas/executor
StateDirectoryMode=0700

# --- additional hardening (does not relax the baseline) ---
CapabilityBoundingSet=
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RemoveIPC=yes
UMask=0077

# --- secrets: systemd-creds, readable only by this unit (services.md section 4) ---
LoadCredentialEncrypted=google-oauth-client:/var/lib/atlas/credentials/atlas-executor/google-oauth-client.cred
LoadCredentialEncrypted=google-send-refresh-token:/var/lib/atlas/credentials/atlas-executor/google-send-refresh-token.cred
LoadCredentialEncrypted=discord-poster-bot-token:/var/lib/atlas/credentials/atlas-executor/discord-poster-bot-token.cred

# --- environment ---
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/var/lib/atlas/current/backend
Environment=HTTPS_PROXY=http://127.0.0.1:3133

# --- code runs from the active release through the symlink, never a versioned path (services.md section 6) ---
ExecStart=/var/lib/atlas/current/venv/atlas-executor/bin/python -m atlas.integrations.executor
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
