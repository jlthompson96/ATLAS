# atlas-backup.service: Nightly encrypted restic backup to a USB drive (ADR 0002).
# Source of truth: contracts/services.md (user, credentials, sandbox baseline). Status: Phase 0.
# Started by atlas-backup.timer, never by atlas-release (services.conf: enable=no). provision-pi.sh enables the timer
# only once /etc/atlas/backup.conf lists a drive and the backup-repo-password credential exists.
#
# Relaxations of the services.md section 5 baseline (each is also marked where it applies):
#   CAP_DAC_READ_SEARCH (services.md section 5, capabilities): read every file it backs up, write none.
#   ReadWritePaths=/mnt/atlas-backup: the only writable place besides the state directory.
# Stricter than the baseline: PrivateNetwork=yes (a USB target needs no network).
#
# The drive is mounted by atlas-backup-mount.service (root, host mount namespace) before this sandbox is built, and
# unmounted when this run ends (StopWhenUnneeded there). It is mounted for the length of the run, never all day.

[Unit]
Description=ATLAS backup: Nightly encrypted restic backup to a USB drive
# Timestamps in the status file and in restic snapshots need a set clock (known issue P2).
Wants=time-sync.target
After=time-sync.target
After=local-fs.target
# No drive, no run: the mount helper refuses unless exactly one allowlisted drive is plugged in.
Requires=atlas-backup-mount.service
After=atlas-backup-mount.service

[Service]
Type=oneshot
User=atlas-backup
Group=atlas-backup

# --- services.md section 5 baseline ---
DynamicUser=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
# ADDED PrivateNetwork: the services.md addition for atlas-backup (stricter, not looser).
PrivateNetwork=yes
StateDirectory=atlas/backup
StateDirectoryMode=0700
ReadWritePaths=/mnt/atlas-backup

# --- capability (services.md section 5) ---
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

# --- additional hardening (does not relax the baseline) ---
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RemoveIPC=yes
UMask=0077
# Stay out of the way of voice and the HUD; a backup can take its time.
Nice=10
IOSchedulingClass=idle
MemoryMax=1G
TimeoutStartSec=3h

# --- credentials (services.md section 4) ---
LoadCredentialEncrypted=backup-repo-password:/var/lib/atlas/credentials/atlas-backup/backup-repo-password.cred

# --- environment ---
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/var/lib/atlas/current/backend

# --- code runs from the active release through the symlink, never a versioned path (services.md section 6) ---
ExecStart=/var/lib/atlas/current/venv/atlas-backup/bin/python -m atlas.backup run
