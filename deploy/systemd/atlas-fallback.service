# atlas-fallback.service: Pi fallback LLM for intent routing (PiLocalBackend).
# Source of truth: contracts/services.md (user, credentials, sockets, ports, sandbox baseline). Status: Phase 1.
#
# Relaxations of the services.md section 5 baseline (each is also marked RELAXED where it applies):
#   MemoryMax=1G: the PLAN 3.1 budget for the <=1B Q8 fallback model; the kernel preempts it, voice wins.
#   MemoryDenyWriteExecute=no: llama.cpp may need it; tighten after measurement (services.md section 5).

[Unit]
Description=ATLAS fallback: Pi fallback LLM for intent routing (PiLocalBackend)
Requires=nftables.service
After=nftables.service
# Audit is mandatory: no audit socket, no service (fail closed).
Requires=atlas-audit.socket
After=atlas-audit.socket
# Socket-activated: systemd owns the listening socket and passes it as fd 3 (LISTEN_FDS).
Requires=atlas-fallback.socket
After=atlas-fallback.socket

[Service]
Type=simple
User=atlas-fallback
Group=atlas-fallback
# Membership of the shared socket groups (see the .socket units and contracts/proposals).
SupplementaryGroups=atlas-audit-clients atlas-core-clients

# --- services.md section 5 baseline ---
DynamicUser=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# RELAXED MemoryDenyWriteExecute: see the header comment.
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service
SystemCallArchitectures=native
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
StateDirectory=atlas/fallback
StateDirectoryMode=0700

# --- additional hardening (does not relax the baseline) ---
CapabilityBoundingSet=
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RemoveIPC=yes
UMask=0077
MemoryMax=1G

# --- environment ---
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/var/lib/atlas/current/backend

# --- code runs from the active release through the symlink, never a versioned path (services.md section 6) ---
ExecStart=/var/lib/atlas/current/venv/atlas-fallback/bin/python -m atlas.llm.fallback_server
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
