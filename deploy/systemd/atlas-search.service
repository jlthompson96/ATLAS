# atlas-search.service: Private SearXNG instance.
# Source of truth: contracts/services.md (user, credentials, sockets, ports, sandbox baseline). Status: Phase 5.
# TEMPLATE: the executable below is a placeholder until this service exists; provision-pi.sh installs but does not enable it.
#
# Relaxations of the services.md section 5 baseline (each is also marked RELAXED where it applies):
#   RestrictAddressFamilies: AF_INET added to reach the atlas-egress proxy on 127.0.0.1:3136
#     (the baseline's AF_UNIX-only cannot work for an HTTPS_PROXY client). IPAddressAllow=localhost keeps it
#     loopback-only; nftables lets only this user connect to its own proxy port.
#   TODO(VM): measure whether MemoryDenyWriteExecute=yes works here (JIT or W+X mappings); relax only if measured necessary.

[Unit]
Description=ATLAS search: Private SearXNG instance
Requires=nftables.service
After=nftables.service
# Audit is mandatory: no audit socket, no service (fail closed).
Requires=atlas-audit.socket
After=atlas-audit.socket
# Survives an atlas-egress restart (the proxy just refuses until it is back).
Wants=atlas-egress.service
After=atlas-egress.service

[Service]
Type=simple
User=atlas-search
Group=atlas-search
# Membership of the shared socket groups (see the .socket units and contracts/proposals).
SupplementaryGroups=atlas-audit-clients

# --- services.md section 5 baseline ---
DynamicUser=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
IPAddressDeny=any
# RELAXED IPAddressAllow: see the header comment.
IPAddressAllow=localhost
# RELAXED RestrictAddressFamilies: see the header comment.
RestrictAddressFamilies=AF_UNIX AF_INET
StateDirectory=atlas/search
StateDirectoryMode=0700

# --- additional hardening (does not relax the baseline) ---
CapabilityBoundingSet=
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RemoveIPC=yes
UMask=0077

# --- environment ---
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/var/lib/atlas/current/backend
Environment=HTTPS_PROXY=http://127.0.0.1:3136
# SearXNG sends its engine traffic through the proxy (PLAN 2.13): outgoing.proxies in its settings.yml.

# --- code runs from the active release through the symlink, never a versioned path (services.md section 6) ---
# PLACEHOLDER: SearXNG's own entry point, installed into the release in Phase 5; bound to 127.0.0.1:8888.
ExecStart=/var/lib/atlas/current/searxng/bin/searxng-run
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
